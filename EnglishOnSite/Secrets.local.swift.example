import Foundation

/// Скопируй в Secrets.local.swift и впиши ключи ОДИН раз на Mac (Kolya).
/// Secrets.local.swift в .gitignore — не коммить и не кидай в чат.
/// ElevenLabs: вставь Secret (sk_…), НЕ Key ID (64 hex). После сборки телефон
/// подхватывает ключ сам — повторный ввод в Настройках не нужен.
enum SecretsLocal {
    static let geminiAPIKey = ""
    /// Пример: "sk_xxxxxxxx" — Secret из ElevenLabs → API keys (не Key ID).
    static let elevenLabsAPIKey = ""
}
